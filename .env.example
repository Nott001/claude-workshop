# Placeholders only — real values are produced by `pnpm db:env local`,
# never entered by hand. See scripts/db-env.mjs.
#
# The app loads env from `.env` (not `.env.remote`). db:env rewrites the three
# NEXT_PUBLIC_SUPABASE_* / SUPABASE_SERVICE_ROLE_KEY lines and NEXT_PUBLIC_APP_URL
# in `.env`, snapshotting the previous file to `.env.remote` so
# `pnpm db:env remote` restores it exactly.

SUPABASE_DB_PASSWORD=postgres

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SALT=

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=