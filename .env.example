# Placeholders only — real values live in the gitignored `.env`, which
# `pnpm db:env` points at one of two named targets:
#
#   pnpm db:env local   # local stack, values from `supabase status`
#   pnpm db:env remote  # hosted project, values from the `.env.remote` overlay
#
# The app loads env from `.env`. db:env owns only the Supabase block
# (NEXT_PUBLIC_SUPABASE_* / SUPABASE_SERVICE_ROLE_KEY / NEXT_PUBLIC_APP_URL);
# everything else in `.env` survives both switches. See docs/LOCAL_DB.md.

SUPABASE_DB_PASSWORD=postgres

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SALT=

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=