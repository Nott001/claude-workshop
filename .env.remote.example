# Overlay for `pnpm db:env remote` — points the app at the hosted Supabase
# project instead of the local stack. Copy to `.env.remote`, fill in the
# hosted project's real keys, then `pnpm db:env remote`. Only these keys are
# merged into `.env`; everything else there is left alone.
#
# Placeholders only — the real `.env.remote` is gitignored; never commit keys.

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

NEXT_PUBLIC_APP_URL=http://localhost:3000