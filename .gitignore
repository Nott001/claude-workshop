# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# design
design-system*
*.fig

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# clerk
.clerk

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
# sidecar snapshot holding the pre-local env for `pnpm db:env remote`
.env.remote

# cloudflare — build output and wrangler's local state, both regenerated by
# `pnpm cf:build`. `.dev.vars` holds real secrets for `wrangler dev`; the
# example file next to it is the checked-in template.
/.open-next/
/.wrangler/
.dev.vars*
!.dev.vars.example
# `wrangler types` derives this from wrangler.jsonc *and* whatever .env / .dev.vars
# the machine happens to hold, so a committed copy encodes one developer's local
# environment. Regenerate with `pnpm cf:typegen`.
/cloudflare-env.d.ts

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# session handoffs — a snapshot of in-flight work, stale as soon as it is written.
# Durable rules belong in AGENTS.md instead, which is loaded every session.
/.handoff/

# playwright
/test/e2e/.results
/test/e2e/.report
/playwright-report
/blob-report
/.playwright

# lighthouse
/.lighthouseci

# claude code — local tool config, not part of the project
/.claude/
