# Supply-chain controls. Pinned explicitly so local installs and CI agree
# instead of inheriting whatever default the installed pnpm version ships.

# Reject dependency versions published within this window. Freshly-published
# versions are how compromised-maintainer attacks land; a delay lets advisories
# surface before the version can enter our lockfile.
minimumReleaseAge=1440

# Lockfile is the source of truth. CI additionally passes --frozen-lockfile.
resolution-mode=highest
